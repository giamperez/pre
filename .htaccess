Options -Indexes
RewriteEngine On

# API proxy
RewriteCond %{REQUEST_URI} ^/api [NC]
RewriteRule ^api/(.*)$ http://127.0.0.1:3013/$1 [P,L]

# Precotizador público en /cotiza/
RewriteCond %{REQUEST_URI} ^/cotiza [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^cotiza/(.*)$ /cotiza/index.html [L]

# Cotizador interno — todo lo demás
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /cotizador/index.html [L]

DirectoryIndex cotizador/index.html index.html
Options -MultiViews
