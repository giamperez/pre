// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                String  @id @default(uuid())
  name              String
  slug              String  @unique
  logoUrl           String?
  colorPrimary      String?
  colorSecondary    String?
  coverImageUrl     String?
  backCoverImageUrl String?
  contactPhone      String?
  contactEmail      String?
  paymentInfo       String?

  catalogItems ServiceCatalogItem[]
  leads        Lead[]
  quotes       Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceCatalogItem {
  id          String  @id @default(uuid())
  companyId   String
  category    String
  name        String
  description String?
  basePrice   Float
  isAddon     Boolean @default(false)
  currency    String  @default("PEN")

  company Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
}

enum LeadClassification {
  calificado
  no_calificado
  pendiente
}

model Lead {
  id             String             @id @default(uuid())
  companyId      String
  name           String
  businessName   String?
  phone          String?
  email          String?
  source         String?
  answers        Json?
  classification LeadClassification @default(pendiente)
  notes          String?

  company Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quote {
  id              String  @id @default(uuid())
  companyId       String
  number          String
  clientData      Json
  projectData     Json
  items           Json
  additionalItems Json?
  subtotal        Float
  igv             Float
  total           Float
  considerations  String?
  images          Json?

  company Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
