// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ventas") // admin, ventas
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id                String  @id @default(uuid())
  name              String
  slug              String  @unique
  logoUrl           String?
  colorPrimary      String?
  colorSecondary    String?
  coverImageUrl     String?
  backCoverImageUrl String?
  letterheadUrl     String?
  contactPhone      String?
  contactEmail      String?
  paymentInfo       String?
  isActive          Boolean @default(true)

  legalName        String?
  taxId            String?
  country          String?
  legalEntityType  String?
  fiscalAddress    String?

  catalogItems ServiceCatalogItem[]
  leads        Lead[]
  quotes       Quote[]
  templates    QuoteTemplate[]
  availability Availability[]
  bookings     Booking[]

  whatsappSession WhatsAppSession?
  whatsappChats   WhatsAppChat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceCatalogItem {
  id          String  @id @default(uuid())
  companyId   String
  category    String
  name        String
  description String?
  basePrice   Float
  isAddon     Boolean @default(false)
  currency    String  @default("PEN")

  company Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
}

enum LeadClassification {
  calificado
  no_calificado
  pendiente
}

model Lead {
  id             String             @id @default(uuid())
  companyId      String
  name           String
  businessName   String?
  phone          String?
  email          String?
  source         String?
  answers        Json?
  classification LeadClassification @default(pendiente)
  notes          String?

  company       Company        @relation(fields: [companyId], references: [id])
  whatsappChats WhatsAppChat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quote {
  id              String  @id @default(uuid())
  companyId       String
  number          String
  clientData      Json
  projectData     Json
  items           Json
  additionalItems Json?
  subtotal        Float
  igv             Float
  total           Float
  considerations  String?
  sections        Json?
  images          Json?

  ubicacionProyecto      String?
  sectorProyecto         String?
  tipoProyecto           String?
  tipoServicio           String?
  tipoCliente            String?
  clienteNuevoRecurrente String?
  fuenteCliente          String?
  estado                 String  @default("borrador")
  metadata               Json?

  company Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuoteTemplate {
  id          String   @id @default(uuid())
  companyId   String
  code        String
  name        String
  category    String
  projectData Json
  items       Json
  sections    Json?
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
}

model Availability {
  id          String   @id @default(uuid())
  companyId   String
  dayOfWeek   Int      // 0=domingo, 1=lunes ... 6=sábado
  startTime   String   // "09:00"
  endTime     String   // "18:00"
  slotMinutes Int      @default(30)
  isActive    Boolean  @default(true)
  type        String   @default("disponible") // "disponible" o "consultar"
  company     Company  @relation(fields: [companyId], references: [id])
}

model Booking {
  id          String   @id @default(uuid())
  companyId   String
  leadId      String?
  clientName  String
  clientEmail String
  clientPhone String?
  date        String   // "2026-07-25"
  time        String   // "10:00"
  status      String   @default("pendiente") // pendiente, confirmada, cancelada
  notes       String?
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id])
}

enum WhatsAppSessionStatus {
  disconnected
  qr_pending
  connecting
  connected
}

model WhatsAppSession {
  id                 String                @id @default(uuid())
  companyId          String                @unique
  status             WhatsAppSessionStatus @default(disconnected)
  qrCode             String?
  phoneNumber        String?
  authDir            String?
  lastConnectedAt    DateTime?
  lastDisconnectedAt DateTime?
  disconnectReason   String?

  company Company        @relation(fields: [companyId], references: [id])
  chats   WhatsAppChat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsAppChat {
  id                 String    @id @default(uuid())
  companyId          String
  sessionId          String
  waJid              String
  contactName        String?
  leadId             String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int       @default(0)

  session  WhatsAppSession   @relation(fields: [sessionId], references: [id])
  company  Company           @relation(fields: [companyId], references: [id])
  lead     Lead?             @relation(fields: [leadId], references: [id])
  messages WhatsAppMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, waJid])
}

model WhatsAppMessage {
  id           String   @id @default(uuid())
  chatId       String
  waMessageId  String?
  direction    String // "in" | "out"
  body         String   @db.Text
  status       String   @default("sent") // sent, delivered, read, failed
  sentByUserId String?
  createdAt    DateTime @default(now())

  chat WhatsAppChat @relation(fields: [chatId], references: [id])

  @@unique([chatId, waMessageId])
}

