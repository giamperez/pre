// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("usuario") // superadmin, admin, usuario
  isActive  Boolean  @default(true)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  permissions Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id                String  @id @default(uuid())
  name              String
  slug              String  @unique
  logoUrl           String?
  colorPrimary      String?
  colorSecondary    String?
  coverImageUrl     String?
  backCoverImageUrl String?
  letterheadUrl     String?
  contactPhone      String?
  contactEmail      String?
  paymentInfo       String?
  customFields      Json?
  permissions       Json?   // Módulos activados para la empresa
  isActive          Boolean @default(true)

  legalName        String?
  taxId            String?
  country          String?
  legalEntityType  String?
  fiscalAddress    String?

  users        User[]
  catalogItems ServiceCatalogItem[]
  leads        Lead[]
  quotes       Quote[]
  templates    QuoteTemplate[]
  availability Availability[]
  bookings     Booking[]

  whatsappSession WhatsAppSession?
  whatsappChats   WhatsAppChat[]
  precotizadorChats PrecotizadorChatSession[]

  contracts    ContractDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceCatalogItem {
  id          String  @id @default(uuid())
  companyId   String
  category    String
  name        String
  description String?
  basePrice   Float
  isAddon     Boolean @default(false)
  currency    String  @default("PEN")

  company Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
}

enum LeadClassification {
  calificado
  no_calificado
  pendiente
}

model Lead {
  id             String             @id @default(uuid())
  companyId      String
  name           String
  businessName   String?
  phone          String?
  email          String?
  source         String?
  answers        Json?
  classification LeadClassification @default(pendiente)
  notes          String?

  company           Company                   @relation(fields: [companyId], references: [id])
  whatsappChats     WhatsAppChat[]
  precotizadorChats PrecotizadorChatSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quote {
  id              String  @id @default(uuid())
  companyId       String
  number          String
  clientData      Json
  projectData     Json
  items           Json
  additionalItems Json?
  subtotal        Float
  igv             Float
  total           Float
  considerations  String?
  sections        Json?
  images          Json?

  ubicacionProyecto      String?
  sectorProyecto         String?
  tipoProyecto           String?
  tipoServicio           String?
  tipoCliente            String?
  clienteNuevoRecurrente String?
  fuenteCliente          String?
  estado                 String  @default("borrador")
  metadata               Json?

  company Company @relation(fields: [companyId], references: [id])
  auditLogs QuoteAuditLog[]
  contracts ContractDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuoteAuditLog {
  id          String   @id @default(uuid())
  quoteId     String
  userId      String?
  userName    String?
  userEmail   String?
  action      String   // "CREACION", "EDICION", "CAMBIO_ESTADO", "IMPORTACION", "DESCARGA_PDF"
  description String   @db.Text
  metadata    Json?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model QuoteTemplate {
  id          String   @id @default(uuid())
  companyId   String
  code        String
  name        String
  category    String
  type        String   @default("cotizacion") // "cotizacion" | "precotizacion"
  projectData Json
  items       Json
  sections    Json?
  cardsConfig  Json?
  customFields Json?
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
}

model Availability {
  id          String   @id @default(uuid())
  companyId   String
  dayOfWeek   Int      // 0=domingo, 1=lunes ... 6=sábado
  startTime   String   // "09:00"
  endTime     String   // "18:00"
  slotMinutes Int      @default(30)
  isActive    Boolean  @default(true)
  type        String   @default("disponible") // "disponible" o "consultar"
  company     Company  @relation(fields: [companyId], references: [id])
}

model Booking {
  id          String   @id @default(uuid())
  companyId   String
  leadId      String?
  clientName  String
  clientEmail String
  clientPhone String?
  date        String   // "2026-07-25"
  time        String   // "10:00"
  status      String   @default("pendiente") // pendiente, confirmada, cancelada
  notes       String?
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id])
}

enum WhatsAppSessionStatus {
  disconnected
  qr_pending
  connecting
  connected
}

model WhatsAppSession {
  id                 String                @id @default(uuid())
  companyId          String                @unique
  status             WhatsAppSessionStatus @default(disconnected)
  qrCode             String?
  phoneNumber        String?
  authDir            String?
  lastConnectedAt    DateTime?
  lastDisconnectedAt DateTime?
  disconnectReason   String?

  company Company        @relation(fields: [companyId], references: [id])
  chats   WhatsAppChat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsAppChat {
  id                 String    @id @default(uuid())
  companyId          String
  sessionId          String
  waJid              String
  contactName        String?
  leadId             String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int       @default(0)

  session  WhatsAppSession   @relation(fields: [sessionId], references: [id])
  company  Company           @relation(fields: [companyId], references: [id])
  lead     Lead?             @relation(fields: [leadId], references: [id])
  messages WhatsAppMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, waJid])
}

model WhatsAppMessage {
  id           String   @id @default(uuid())
  chatId       String
  waMessageId  String?
  direction    String // "in" | "out"
  body         String   @db.Text
  status       String   @default("sent") // sent, delivered, read, failed
  sentByUserId String?
  createdAt    DateTime @default(now())

  chat WhatsAppChat @relation(fields: [chatId], references: [id])

  @@unique([chatId, waMessageId])
}

model PrecotizadorChatSession {
  id               String   @id @default(uuid())
  companyId        String
  leadId           String?
  customerName     String?  @default("Cliente Precotizador")
  customerPhone    String?
  customerEmail    String?
  status           String   @default("BOT_ACTIVE") // BOT_ACTIVE, HUMAN_TAKEOVER, CLOSED
  assignedUserId   String?
  assignedUserName String?
  unreadCountSales Int      @default(0)
  lastMessageAt    DateTime @default(now())
  summary          String?  @db.Text
  analysisResult   Json?
  isSavedWithLead  Boolean  @default(false)

  company          Company                 @relation(fields: [companyId], references: [id])
  lead             Lead?                   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages         PrecotizadorChatMessage[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PrecotizadorChatMessage {
  id          String   @id @default(uuid())
  sessionId   String
  sender      String   // "user", "bot", "agent"
  senderName  String?
  content     String   @db.Text
  metadata    Json?

  session     PrecotizadorChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

model ContractDocument {
  id                String   @id @default(uuid())
  companyId         String
  quoteId           String?
  type              String   // "contrato" | "conformidad"
  number            String   // Ej: CON-202608-01 o ACT-202608-01
  title             String
  version           String   @default("1.0") // "1.0", "2.0", "3.0"
  clientData        Json
  employerData      Json
  servicesData      Json
  contentHtml       String   @db.Text
  status            String   @default("borrador") // "borrador", "emitido", "firmado"
  isLocked          Boolean  @default(false)
  pdfPath           String?
  providerSignature String?  @db.Text
  clientSignature   String?  @db.Text
  startDate         DateTime?
  endDate           DateTime?
  totalAmount       Float    @default(0)
  metadata          Json?

  company Company @relation(fields: [companyId], references: [id])
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  auditLogs ContractAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContractAuditLog {
  id          String   @id @default(uuid())
  contractId  String
  userId      String?
  userName    String?
  userEmail   String?
  action      String   // "CREACION", "EDICION_TEXTO", "FIRMA_PROVEEDOR", "FIRMA_CLIENTE", "BLOQUEO_EMISION", "DESCARGA_PDF", "NUEVA_VERSION"
  description String   @db.Text
  version     String   @default("1.0")
  metadata    Json?

  contract ContractDocument @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

